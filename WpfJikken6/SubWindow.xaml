<base:BaseWindow
    x:Class="WpfJikken6.SubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:base="clr-namespace:WpfJikken6.Base"
    xmlns:local="clr-namespace:WpfJikken6"
    Title="{Binding Title}"
    Width="800"
    Height="450">
    <base:BaseWindow.Resources>
        <local:HexIntConverter x:Key="HexIntConverter" />
    </base:BaseWindow.Resources>
    <b:Interaction.Behaviors>
        <local:WindowKeyBindingBehavior />
    </b:Interaction.Behaviors>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem
                    Command="{x:Static local:WindowCommands.Close}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Header="閉じる" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <DataGrid
                Grid.Row="0"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserSortColumns="False"
                ItemsSource="{Binding GridItems}"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Style="{StaticResource DataGridBaseStyle}">
                <b:Interaction.Behaviors>
                    <local:DataGridCellOneClickActionBehavior />
                </b:Interaction.Behaviors>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名前" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Text}"
                        Header="テキスト" />
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="選択">
                        <DataGridCheckBoxColumn.CellStyle>
                            <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Width="220" Header="種別">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding DisplayText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ComboBox
                                        x:Name="ComboEditor"
                                        DisplayMemberPath="DisplayLabel"
                                        IsDropDownOpen="True"
                                        ItemsSource="{Binding DataContext.ComboBoxItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                        SelectedValue="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Code"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                        VirtualizingPanel.ScrollUnit="Item"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                    <TextBox
                                        x:Name="TextEditor"
                                        Text="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource HexIntConverter}, ConverterParameter=1}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch" />

            <TextBox
                Grid.Row="2"
                Margin="5"
                Padding="8"
                VerticalContentAlignment="Top"
                AcceptsReturn="True"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Description}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</base:BaseWindow>
