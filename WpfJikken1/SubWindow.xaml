<Window
    x:Class="WpfJikken1.SubWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behavior="clr-namespace:WpfJikken1.Behavior"
    xmlns:local="clr-namespace:WpfJikken1"
    Title="{Binding Title}"
    Width="800"
    Height="450">
    <b:Interaction.Behaviors>
        <behavior:WindowKeyBindingBehavior />
    </b:Interaction.Behaviors>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem
                    Command="{x:Static local:WindowCommands.Close}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Header="閉じる" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="DescriptionRow" Height="150" />
            </Grid.RowDefinitions>

            <DataGrid
                x:Name="PropDataGrid"
                Grid.Row="0"
                Margin="5"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserSortColumns="False"
                FontFamily="MS Gothic"
                FrozenColumnCount="{Binding FrozenColumnCount, Mode=TwoWay}"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                ItemsSource="{Binding GridItems}"
                SelectionMode="Extended"
                SelectionUnit="Cell"
                TextOptions.TextFormattingMode="Display">
                <b:Interaction.Behaviors>
                    <behavior:DataGridCellOneClickActionBehavior />
                </b:Interaction.Behaviors>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding MarkBrush, TargetNullValue=White}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        x:Name="RowHeaderColumn"
                        Width="150"
                        Binding="{Binding Header}"
                        Header=""
                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="4" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter
                x:Name="DescriptionSplitter"
                Grid.Row="1"
                Height="5"
                HorizontalAlignment="Stretch" />

            <TextBox
                Grid.Row="2"
                Margin="5"
                AcceptsReturn="True"
                Text="{Binding Description}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
